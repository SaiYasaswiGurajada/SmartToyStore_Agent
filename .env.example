# Copy to .env and fill in. NEVER commit .env.
# Rotate any key that has ever been shared, uploaded or committed.

# ---- LLM ----
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- Gmail (app password, NOT your account password) ----
# Enable 2-Step Verification, then Google Account > Security > App Passwords,
# create one for Mail, and paste the 16-character value below.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# ---- Escalation hierarchy: THREE levels, and Level 1 sends no email ----
# Level 1 is consoled in chat. Only these two addresses ever receive mail.
# Use addresses you actually control. Gmail plus-addressing works:
# yourname+manager@gmail.com
EMAIL_MANAGER=
EMAIL_OWNER=

# ---- Channel ----
# web | whatsapp | both
CHANNEL=whatsapp

# ---- Twilio WhatsApp ----
# Console > Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# The exact public HTTPS URL Twilio calls, including the path.
# e.g. https://your-name.ngrok-free.app/webhook/whatsapp
PUBLIC_WEBHOOK_URL=
